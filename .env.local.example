# ============================================================================
# Environment Variables Configuration
# ============================================================================

# 1. Groq API Configuration (Stages 1, 2, 3, 4, 6)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini API Configuration (Stage 5 Reasoning & Critique)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro

# 3. Supabase Database Configuration (State Persistence)
# Get these in your Supabase project dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
